{
  "use_system_prompts": true,
  "use_system_path_prompts": true,
  "soft_wrap": "editor_width",
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": ["openai/gpt-5.5"],
      },
      "default_config_options": {
        "model": "openai/gpt-5.5",
      },
      "type": "registry",
    },
  },
  "theme": {
    "mode": "system",
    "light": "JetBrains Islands Light",
    "dark": "JetBrains Islands Dark",
  },
  "helix_mode": false,
  "diff_view_style": "split",
  "file_finder": {
    "file_icons": true,
  },
  "max_tabs": 10,
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains Icons Light",
    "dark": "JetBrains Icons Dark",
  },
  "terminal": {
    "font_family": "Fira Code",
    "font_size": 12.5,
    "cursor_shape": "bar",
    "shell": "system",
    "show_count_badge": true,
    "dock": "right",
  },
  "auto_update": false,
  "cli_default_open_behavior": "new_window",
  "ssh_connections": [
    {
      "host": "hetzner",
      "args": [],
      "projects": [
        {
          "paths": ["/home/deploy/OF_api"],
        },
        {
          "paths": ["/home/deploy/openclaw"],
        },
      ],
    },
    {
      "host": "of_api",
      "args": [],
      "projects": [
        {
          "paths": ["/home/deploy/OF_api"],
        },
      ],
    },
  ],
  "project_panel": {
    "sort_mode": "directories_first",
    "hide_hidden": false,
    "hide_root": false,
    "indent_guides": {
      "show": "never",
    },
    "sticky_scroll": true,
    "git_status_indicator": true,
    "diagnostic_badges": false,
    "bold_folder_labels": false,
    "indent_size": 15.0,
    "entry_spacing": "comfortable",
    "folder_icons": true,
    "file_icons": true,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium",
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "tree_view": true,
    "show_count_badge": false,
    "file_icons": true,
    "dock": "left",
  },
  "autosave": "on_focus_change",
  "base_keymap": "SublimeText",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "buffer_font_size": 13,
  "buffer_line_height": {
    "custom": 1.600000023841858,
  },
  "buffer_font_weight": 400.0,
  "ui_font_size": 15,
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "PyRight", "pylsp"],
    },
  },
  "file_types": {
    "TOML": ["config"],
  },
  // "show_wrap_guides": true,
  "wrap_guides": [100],
  "preferred_line_length": 100,
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },

  // Remove the < > buttons from the tab bar
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },

  // Enable Vim mode. You probably found this already if you care.
  "vim_mode": false,

  // Use relative line numbers.
  "relative_line_numbers": "enabled",
}

// Docs: https://romanzipp.com/blog/must-have-zed-settings
