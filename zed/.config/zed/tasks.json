// Global tasks. See https://zed.dev/docs/tasks for documentation.
// Spawn with cmd-shift-r (task: spawn); rerun last with cmd-alt-r (bound in keymap.json).
// Pytest gutter ▶ buttons on test functions/classes work out of the box, no task needed.
[
  {
    "label": "pytest: file",
    "command": "uv run pytest \"$ZED_RELATIVE_FILE\"",
    "reveal": "always",
    "save": "all",
  },
  {
    "label": "pytest: all",
    "command": "uv run pytest",
    "reveal": "always",
    "save": "all",
  },
]
