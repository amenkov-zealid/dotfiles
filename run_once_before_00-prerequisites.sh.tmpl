#!/usr/bin/env bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{ else -}}
# Linux (Debian/Ubuntu) — install core CLI tools
sudo apt-get update -qq
sudo apt-get install -y --no-install-recommends \
  curl git fish tmux fzf ripgrep bat zoxide direnv \
  build-essential ca-certificates

# Install starship
if ! command -v starship >/dev/null 2>&1; then
  curl -sS https://starship.rs/install.sh | sh -s -- --yes
fi

# Install mise
if ! command -v mise >/dev/null 2>&1; then
  curl https://mise.run | sh
fi

# Install atuin
if ! command -v atuin >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh
fi

# Install git-delta
if ! command -v delta >/dev/null 2>&1; then
  DELTA_VERSION=$(curl -s https://api.github.com/repos/dandavison/delta/releases/latest | grep -o '"tag_name": "[^"]*"' | cut -d'"' -f4)
  curl -LO "https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/git-delta_${DELTA_VERSION}_amd64.deb"
  sudo dpkg -i "git-delta_${DELTA_VERSION}_amd64.deb"
  rm "git-delta_${DELTA_VERSION}_amd64.deb"
fi
{{ end -}}
