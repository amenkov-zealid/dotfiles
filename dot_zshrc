# ==============================================================================
# ZSH CONFIGURATION - OPTIMIZED
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
export LANG=en_US.UTF-8
export EDITOR_NO_WAIT="zed"

if [[ -n $SSH_CONNECTION ]]; then
  # SSH background color
  print -n -- "\033]11;#FF00FF\007"
else
  export EDITOR="zed --wait"
fi

# ------------------------------------------------------------------------------
# HISTORY CONFIGURATION
# ------------------------------------------------------------------------------
HISTFILE=$HOME/.zsh_history
SAVEHIST=10000
HISTSIZE=10000
setopt SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS

# ------------------------------------------------------------------------------
# ZSH OPTIONS
# ------------------------------------------------------------------------------
setopt NO_BEEP
setopt AUTO_CD

# ------------------------------------------------------------------------------
# OH-MY-ZSH CONFIGURATION
# ------------------------------------------------------------------------------
ZSH_THEME=""  # Using Starship instead
HYPHEN_INSENSITIVE="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"

# Plugins - only essential ones for performance
plugins=(
  git
  python
  kubectl
  helm
  docker
  zsh-autosuggestions
  zsh-syntax-highlighting
  jira
  web-search
)

source $ZSH/oh-my-zsh.sh

# ------------------------------------------------------------------------------
# COMPLETION SYSTEM
# ------------------------------------------------------------------------------
# Only run compinit once per day for performance
# https://gist.github.com/ctechols/ca1035271ad134841284
fpath+=("$(brew --prefix)/share/zsh/site-functions")
fpath+=~/.zfunc

autoload -Uz compinit
if [[ -n ${ZDOTDIR}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

zstyle ':completion:*' menu select

# ------------------------------------------------------------------------------
# KEY BINDINGS
# ------------------------------------------------------------------------------
# History search with arrow keys
bindkey '^[OA' history-search-backward
bindkey '^[OB' history-search-forward

# ------------------------------------------------------------------------------
# ALIASES
# ------------------------------------------------------------------------------
alias zshconfig="$EDITOR_NO_WAIT ~/.zshrc"
alias ohmyzsh="$EDITOR_NO_WAIT ~/.oh-my-zsh"
alias oc="opencode"
alias lzd='lazydocker'

# Better ls with eza
alias l='eza -lah'
alias la='eza -lAh'
alias ll='eza -lh'
alias ls='eza -G'
alias lsa='eza -lah'

# ------------------------------------------------------------------------------
# EXTERNAL TOOLS
# ------------------------------------------------------------------------------
# Auto-pairing brackets
source $(brew --prefix)/share/zsh-autopair/autopair.zsh

# FZF fuzzy finder
eval "$(fzf --zsh)"

# Starship prompt (load last for best performance)
eval "$(starship init zsh)"
